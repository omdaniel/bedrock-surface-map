{
  "name": "bedrock-surface-map",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "config:test": "node --test scripts/verification-config.test.mjs scripts/private-origin.test.mjs scripts/proxy-integration.test.mjs",
    "demo:prepare": "node scripts/demo.mjs prepare",
    "demo:dev": "node scripts/demo.mjs dev",
    "demo:build": "node scripts/demo.mjs build",
    "demo:test": "node --test scripts/demo-packet.test.mjs scripts/demo-clock.test.ts",
    "terrain:build": "node scripts/build-terrain.mjs",
    "terrain:bundle": "node scripts/bundle-terrain.mjs",
    "terrain:test": "node --test terrain/test/*.test.ts scripts/map-proxy.test.mjs",
    "tracking:build": "node scripts/build-tracking.mjs",
    "tracking:bundle": "node scripts/bundle-tracking.mjs",
    "tracking:test": "node --test tracking/pack/test/*.test.ts tracking/test/*.test.ts scripts/tracker-proxy.test.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "package:linux": "node scripts/release/build-package.mjs",
    "release:audit": "node scripts/release/audit.mjs",
    "release:test": "node --test scripts/release/*.test.mjs",
    "secrets:check": "node scripts/scan-secrets.mjs",
    "assets": "node scripts/assets.mjs",
    "wasm": "node scripts/wasm.mjs",
    "import": "cargo run --release --locked -p surface-cli -- import",
    "fixture": "cargo run --release --locked -p surface-cli -- fixture",
    "dev": "vite --config vite.config.ts",
    "serve:lan": "node scripts/serve-lan.mjs",
    "build": "npm run wasm && tsc --noEmit && vite build --config vite.config.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write web/src web/index.html scripts/**/*.mjs tests tracking terrain vite.config.ts playwright.config.ts",
    "format:check": "prettier --check web/src web/index.html scripts/**/*.mjs tests tracking terrain vite.config.ts playwright.config.ts",
    "test": "playwright test",
    "verify": "cargo test --workspace && npm run build && npm run fixture && npm test"
  },
  "dependencies": {
    "lucide": "^0.577.0"
  },
  "devDependencies": {
    "@minecraft/server": "2.9.0",
    "@minecraft/server-admin": "1.0.0-beta.1.26.40-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.40-stable",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "8.3.0"
  }
}
